<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <!-- OptioBot export: enabled on the source PC -->
  <RegistrationInfo>
    <Description>OptioBot 2.9: download this month of 1-minute history for the scan list and rebuild the opening-volume baseline.</Description>
    <URI>\OptioBot\V29Baseline</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>{USER_SID}</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-12T19:30:00</StartBoundary>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\WINDOWS\System32\cmd.exe</Command>
      <Arguments>/d /c ""{REPO}\.venv\Scripts\python.exe" -u -m trader.v2.in_play baseline &gt;&gt; "{REPO}\data\in_play\baseline.log" 2&gt;&amp;1"</Arguments>
      <WorkingDirectory>{REPO}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>