# Tastytrade production OAuth credentials. Fill these into local .env only.
# Never paste credentials into chat or commit a populated .env.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_ACCOUNT_NUMBER=

# Optional historical SPY/QQQ minute candles for backtests (Massive Stocks API).
# Massive Stocks Basic is end-of-day, limited to 2 years of history, and 5 API calls/minute.
MASSIVE_API_KEY=
# Historical-only source. Selection is explicit; there is no automatic provider failover.
PAPER_HISTORY_PROVIDER=tastytrade_dxlink

# LIVE is blocked unless ALL of these are set locally, `trader.cli authorize-live` has been run for the
# exact strategy hash, and the operator types the confirmation at each `live-session` start.
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
LIVE_START_CONFIRMATION=

# Local sizing/operation overrides. Default paper capital is USD 10,000.
PAPER_STARTING_CASH=10000
OPTIOBOT_DATA_DIR=./data
OPTIOBOT_LOG_MAX_BYTES=10485760

# Optional supervisory reports/critical alerts (STARTTLS SMTP, port 587 by default).
# Configure all fields locally; values are never included in reviewer snapshots.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REPORT_FROM=
REPORT_TO=

# Optional phone push for engine-down / position-critical alerts (ntfy app, iOS/Android).
# Use a long random topic: anyone who knows an ntfy.sh topic name can read it.
NTFY_URL=
NTFY_TOKEN=
# Optional dead-man's switch (e.g. a healthchecks.io check URL). The watchdog pings it every minute while it
# runs; the service alerts you if the pings stop (PC asleep, offline or off) or a /fail ping arrives.
HEALTHCHECK_URL=
