// PROFESSIONAL_STRATEGY_V2: decision stages layered on the UNCHANGED original strategy (strategy.txt, hash pinned
// below). The core opening-range breakout signal, its indicators, contract selection rules, exits and loss limits
// come from strategy.txt and are never modified here. Every stage below is independently enabled, configured,
// tested and logged. Machine-readable JSON with // comments; unknown keys and missing values fail closed.
// Plain-English companion: docs/v2/professional_strategy_v2.md.
{
  "strategy_id": "PROFESSIONAL_STRATEGY_V2",
  "version": "2.8.5",
  "status": "research_test",
  "mode": "PAPER",
  "base_strategy": {
    "filename": "strategy.txt",
    "strategy_id": "opening_range_breakout_options",
    "version": "0.1.6",
    "configuration_hash": "c597cfe86d7971a7e96b08ed71bc58eff6dca6942fcb0288b24498dedf6e902b"
  },
  "sector_map_file": "strategies/v2_sector_map.json",
  "economic_calendar_file": "strategies/v2_economic_calendar.json",

  // Market-context symbols streamed on the engine's one DXLink connection (deduplicated against the trading
  // universe). VIX is an index with no trade volume; it is read from tastytrade REST quotes (one shared, cached
  // request per minute).
  "context": {
    "broad_symbols": ["SPY", "QQQ", "IWM"],
    "sector_etfs": ["XLK", "XLF", "XLE", "XLV", "XLY", "XLI", "XLC", "XLP", "XLU", "XLB", "XLRE"],
    "volatility_index": "VIX",
    "max_bar_age_seconds": 150,
    "vix_max_age_seconds": 180,
    "daily_history_sessions": 60,
    "premarket_start_et": "04:00"
  },

  // Regime from measurable inputs only (docs/v2: rules R1-R6). Per index bias in [-3, 3]:
  // +1/-1 price vs session VWAP, +1/-1 EMA fast vs slow (the strategy's own 9/21 periods), +1/-1 vs the open.
  "regime": {
    "enabled": true,
    "vix_disorderly_level": 30.0,
    "vix_disorderly_change_fraction": 0.15,
    "spy_disorderly_atr_fraction": 0.0025,
    "strong_min_index_bias": 2,
    "strong_min_spy_efficiency": 0.30,
    "strong_min_breadth": 0.60,
    "weak_min_market_score": 3,
    "weak_min_spy_bias": 1,
    "efficiency_window_bars": 30,
    "allowed_directions": {
      "STRONG_BULLISH": ["CALL"],
      "WEAK_BULLISH": ["CALL"],
      "STRONG_BEARISH": ["PUT"],
      "WEAK_BEARISH": ["PUT"],
      "RANGE_BOUND": [],
      "HIGH_VOLATILITY": [],
      "UNCLEAR": []
    }
  },

  "sector": {
    "enabled": true,
    // A single stock's direction must not be contradicted by its sector ETF's bias (same three inputs as the
    // regime). 1 = the sector must lean the trade's way; 0 = a neutral sector is acceptable.
    "min_sector_bias": 1
  },

  // V2 computes a real session VWAP (sum of typical price x volume from the open). Live tastytrade bars carry no
  // VWAP, so the strategy's own VWAP check never runs live (see docs/v2); this V2 stage supplies it separately.
  "vwap_alignment": {"enabled": true},

  "confirmation": {
    "enabled": true,
    // The breakout bar itself is the strategy's qualified signal (a completed close beyond the breakout level).
    // Confirmation then needs this many consecutive completed closes beyond the level (including that bar),
    // the latest at least min_distance_atr x ATR beyond it, within max_wait_bars.
    "confirm_closes": 2,
    "min_distance_atr": 0.25,
    "max_wait_bars": 5,
    "pullback": {
      "enabled": true,
      // A later bar whose low (calls) / high (puts) comes back within retest_tolerance_atr x ATR of the level
      // without closing back inside the opening range, then a completed close beyond the prior bar's high/low.
      "retest_tolerance_atr": 0.25,
      "max_wait_bars": 15
    }
  },

  "correlation": {
    "enabled": true,
    // Pearson correlation of daily close-to-close log returns over the last lookback_sessions completed sessions
    // (tastytrade DXLink daily candles). Two positions are one bet when corr x direction_a x direction_b >= threshold.
    "lookback_sessions": 60,
    "min_observations": 40,
    "threshold": 0.60,
    // Without enough data: same sector ETF, same group for broad indexes, or the same tracked index are grouped.
    "fallback": "sector_and_index_groups"
  },

  "portfolio": {
    "enabled": true,
    // Owner-authorized 2026-10-23. Aggregate open maximum loss (premium x 100 x qty + modeled round-trip costs)
    // as a fraction of equity, by active account profile.
    "aggregate_max_loss_fraction": {"ORIGINAL_ACCOUNT_PAPER": 0.30, "SMALL_ACCOUNT_PAPER": 0.40},
    // Owner-authorized 2026-10-23: one correlated cluster's combined maximum loss <= one per-trade budget.
    "cluster_max_loss": "one_trade_budget"
  },

  "option_quality": {
    "enabled": true,
    "max_quote_age_seconds": 30,
    "min_bid_size": 1,
    "min_ask_size": 1,
    // Volatility inputs come from tastytrade market-metrics (IV rank/percentile over its own 52-week history,
    // 30-day historical volatility). V2 does not compute its own IV rank.
    "max_iv_rank": 0.85,
    // Extreme-outlier guard only. Implied normally exceeds realized volatility: across the 55 V2 symbols on
    // 2026-10-23 IV index / HV30 had median 1.49, 90th percentile 1.83, max 2.30. IV rank and the earnings rules
    // carry the "unusually expensive" judgement; this rejects only a premium far above anything seen in that sample.
    "max_iv_to_hv30": 2.5,
    "max_contract_iv_to_index_iv": 1.30,
    "max_metrics_age_minutes": 30,
    "missing_volatility_data": "reject"
  },

  "events": {
    "enabled": true,
    "earnings": {
      // Entries are flattened at the close, so the risk is paying the pre-report IV premium.
      "reject_if_reports_today_after_close": true,
      "reject_if_reports_next_session_before_open": true,
      "reported_today_before_open": "review",
      "unknown_time_of_day": "treat_as_both",
      "estimated_date": "apply_and_flag_unverified",
      "metrics_unavailable": "reject"
    },
    "economic": {
      "FOMC_RATE_DECISION": {"block_entries_from_et": "13:30", "block_entries_until_et": "15:00", "open_positions": "review"},
      // 08:30 ET releases print before the open; the 15-minute opening range already contains the reaction.
      "pre_open_release_types": ["CPI", "PPI", "EMPLOYMENT_SITUATION", "GDP", "PCE"],
      "pre_open_release_block_minutes_after_open": 0
    },
    "calendar_expired": "reject"
  },

  "sizing": {
    // Owner decision 2026-10-23: 1 contract for week 1. The risk-based quantity is computed and logged.
    "max_contracts": 1,
    "max_fraction_of_displayed_size": 0.5,
    "max_fraction_of_open_interest": 0.01,
    "quality_score_affects_size": false
  },

  // Bigger-picture trend: a CALL needs the price above, a PUT below, the average of the last sma_sessions daily closes.
  "daily_trend": {"enabled": false, "sma_sessions": 20},

  // Entry filters from the 2026-10-27 replay scorecard (each lost in all three replay periods): no entries in the
  // excluded symbols, and none in the skip window (ET), the first minutes after the opening range forms.
  // 2.5.0 (owner-authorized 2026-11-05): BAC and DIA also excluded; both lost in the replay in June-August and again afterward.
  "entry_filters": {"enabled": true, "exclude_symbols": ["TLT", "BAC", "DIA"], "skip_from_et": "10:00", "skip_until_et": "10:30"},

  // Fewer trades: at most this many V2 entries per session (on top of the original 6-per-day risk limit).
  "trade_limits": {"enabled": false, "max_entries_per_session": 3},

  // Late entries: no new V2 entries in the final N minutes before the close (today's actual close on early-close
  // days). Every trade is sold at the close, so a late entry mostly pays fees and the spread.
  "late_entry_cutoff": {"enabled": true, "no_entries_final_minutes": 30},

  // Loss streak: the original strategy stops entries after 3 losing trades in a row and only a win resets it, so a
  // streak carries into later sessions with no way to end it. reset_each_session counts only today's trades.
  "loss_streak": {"reset_each_session": true},

  // Opening range width: skip a breakout whose 15-minute opening range is under this fraction of the price
  // (equity_fraction for single stocks, etf_fraction for funds and indexes); a narrow range puts the stop inside noise.
  "min_opening_range": {"enabled": false, "etf_fraction": 0.003, "equity_fraction": 0.006},

  "management": {
    // require_option_above_floor: breakeven arms only once the option bid has actually covered cost + fees.
    "breakeven": {"enabled": true, "trigger_r": 1.0, "require_option_above_floor": true},
    // let_winners_run: at the target, hold instead of selling; the stop locks in lock_r x R and trails trail_r x R
    // behind the best price (R = the initial stop distance). 2.4.0 (owner, 2026-10-29): trail 1.5R behind.
    // 2.8.1 (owner, 2026-11-17, after a LIVE IWM put gave back about half its peak gain on a 1.5R trail): once the
    // best price is 3R in favour (tighten_after_r), the trail closes to 0.75R behind it (tight_trail_r).
    // 2.8.5 (owner, 2026-11-20): tighten at 2R instead of 3R ("2X"). Replay 11/19 (reports/new_rules_20261119):
    // -0.198R vs -0.200R net per trade on 2.8.1 entries, i.e. no measurable change either way.
    "let_winners_run": {"enabled": true, "lock_r": 1.0, "trail_r": 1.5, "tighten_after_r": 2.0, "tight_trail_r": 0.75},
    // trailing: off from 2.4.0, so a winner is no longer sold on a 1-ATR dip before it reaches the target.
    // atr_multiple: "rules.stop_underlying_atr" or a number of ATRs.
    "trailing": {"enabled": false, "trigger_r": 1.0, "atr_multiple": "rules.stop_underlying_atr"},
    "time_stop": {"enabled": false, "after_minutes": 60, "min_progress_r": 0.25},
    "partial_profit": {"enabled": false, "trigger_r": 1.0, "fraction": 0.5},
    // 2.8.4 (owner, 2026-11-20, LIVE NFLX put up ~$50 with only a breakeven stop below it): "I don't want to lose more
    // than $20 ... If it goes to $100 in profit, I want at least $60. The bot needs to trail the profit." Once the
    // best net profit on the option bid (after fees) reaches activate_profit_dollars per contract, sell when the bid
    // falls to keep_fraction of that best profit (up $50 -> keep $30, up $100 -> keep $60). Only ever rises.
    // 2.8.5 (owner, 2026-11-20 13:20 CT: "the profit lock is a fixed amount? I want it to be a percentage"): the lock
    // starts once the net profit is activate_profit_fraction of the premium paid (10%: $26 on a $257 contract, $100 on a
    // $1,000 one) instead of a fixed $30; it still keeps keep_fraction (60%) of the best net profit.
    "profit_lock": {"enabled": true, "activate_profit_fraction": 0.10, "keep_fraction": 0.60}
  },

  "shadow_benchmark": {"enabled": true},

  // 2.8.0 (owner-authorized 2026-11-11, review reports/review_20261111). Cost gate: the contract's round-trip cost
  // (bid/ask gap in and out, fees, slippage) divided by what one R of stock move is worth on it (|delta| x stop
  // distance x 100). enforce false = measured and logged on every approved candidate, nothing is blocked; the nightly
  // scoreboard shows what the gate would have kept and dropped. Set enforce true for a profile to switch it on
  // (it then also takes the place of the "expected net R" gate, which has no relationship to results).
  // Not enforced on day one: on the $10K's 45 live trades a 0.20R limit would have dropped 20 trades that made +$87
  // in total, and on the $1K it would block nearly every trade (owner 2026-11-08: do not pause the $1K).
  "cost_gate": {
    "enabled": true,
    "max_cost_r": {"ORIGINAL_ACCOUNT_PAPER": 0.20, "SMALL_ACCOUNT_PAPER": 0.20},
    "enforce": {"ORIGINAL_ACCOUNT_PAPER": false, "SMALL_ACCOUNT_PAPER": false},
    "replaces_expected_net_r_gate": true
  },

  // 2.8.0 (owner-authorized 2026-11-11). The advisor (any agent, see agents.json) may block entries in one symbol
  // for a stated reason until a stated time (data/advisor/vetoes.json). Block-only: it never adds a trade or changes
  // size. The file is ignored once older than max_age_minutes, so a stopped advisor leaves no block behind.
  "ai_veto": {"enabled": true, "enforce": true, "max_age_minutes": 90},

  // 2.8.3 (owner, 2026-11-20) = 2.8.1 + this LIVE entry retry only. The 2.8.2 entry rules (daily-range ruler,
  // pullback-only, room to the target) were dropped: the 2-year replay (reports/new_rules_20261119) put 2.8.2 at
  // -0.31R net per trade vs -0.20R for 2.8.1. Origin: LIVE IWM put 2026-11-19 cancelled unfilled at the 11-second-old
  // $3.36 ask while paper filled at $3.41. LIVE entries only: up to max_attempts limit orders, each at the contract's
  // current ask, each waiting attempt_timeout_seconds. Stops when the ask is more than max_chase_fraction above the
  // decision ask, the trade's budget would be exceeded, the stock is past the stop, or it already covered
  // max_move_toward_target of the way to the target. PAPER fills are unchanged.
  "live_entry": {"enabled": true, "max_attempts": 3, "attempt_timeout_seconds": 8, "max_chase_fraction": 0.03,
                 "max_move_toward_target": 0.5},

  // 2.8.5 (owner, 2026-11-20): "agents don't need to agree if one agent finds an almost sure winner that should be
  // purchased." Every agent in agents.json roles.advisor_panel reviews the news hourly (08:00-14:00 CT); an idea any
  // one of them marks "almost_sure" is bought, PAPER and LIVE (trader/v2/agent_picks.py). Skips the breakout,
  // regime, sector and volume stages. Keeps the kill switch, broker checks, entry window, 10:00-10:30 ET pause,
  // late cutoff, events, position limits, budget, risk engine, option quality and the management exits.
  // valid_minutes: a pick not bought within this time after the agent's reply is dropped.
  // max_per_session: agent picks bought per account per day.
  // max_move_toward_target: no chasing; skip once the stock covered this much of the way to the pick's target.
  // min_expected_net_r: replaces the strategy's 1.0 minimum for picks (the option cost must not eat the target).
  // honor_vetoes false: another agent's veto does not block a pick (agents need not agree).
  "agent_picks": {"enabled": true, "valid_minutes": 50, "max_per_session": 1, "max_move_toward_target": 0.5,
                  "min_expected_net_r": 0.3, "honor_vetoes": false}
}
